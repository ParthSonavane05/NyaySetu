# ─── Environment ───
NYAYSETU_ENV=local

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://nyaysetu:nyaysetu_dev@localhost:5432/nyaysetu
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── S3/MinIO ───
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nyaysetu-documents
S3_REGION=us-east-1

# ─── Security ───
SECRET_KEY=change-me-in-production-use-64-char-hex
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=60
